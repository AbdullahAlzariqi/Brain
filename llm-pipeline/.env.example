# OpenAI API Configuration
# Required for the Judge model (GPT-4)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Google Generative AI Configuration
# Required for the Teacher model (Gemini)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Student Model Configuration (Optional)
# Set to "false" to use a real local model instead of mock
# Default: "true" (uses mock model for faster testing)
MOCK_STUDENT=true

# Device Configuration (Optional)
# Options: "cuda", "cpu", "mps" (for Apple Silicon)
# Default: "cuda"
# DEVICE=cuda
